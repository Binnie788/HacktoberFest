# Lumina Camera Backend Configuration

# AI Provider: 'gemini' for Google AI Studio (hosted) or 'ollama' for self-hosted local model
LLM_PROVIDER=gemini

# Google AI Studio API Key (Required for LLM_PROVIDER=gemini)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model ID for Gemini API
# Options: 'gemma-4-26b-a4b-it' (Fast MoE, recommended) or 'gemma-4-31b-it' (Dense)
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# Self-Hosted Ollama Configuration (Used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Server Security & Performance Limits
CORS_ORIGINS=["*"]
MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT_PER_MINUTE=60
HOST=0.0.0.0
PORT=8000
